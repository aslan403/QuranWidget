<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.quran-desktop" path="/org/gnome/shell/extensions/quran-desktop/">
    <key name="page" type="i">
      <range min="1" max="604"/>
      <default>1</default>
      <summary>Reading page</summary>
      <description>Page number 1–604. Madani mode preserves the original image layout; transparent text mode reflows verses.</description>
    </key>
    <key name="height" type="i">
      <range min="320" max="1600"/>
      <default>760</default>
      <summary>Widget height in logical pixels</summary>
    </key>
    <key name="position-x" type="i">
      <range min="0" max="100"/>
      <default>86</default>
      <summary>Horizontal position percentage</summary>
    </key>
    <key name="position-y" type="i">
      <range min="0" max="100"/>
      <default>50</default>
      <summary>Vertical position percentage</summary>
    </key>
    <key name="opacity" type="i">
      <range min="20" max="100"/>
      <default>100</default>
      <summary>Widget opacity percentage</summary>
    </key>
    <key name="background-opacity" type="i">
      <range min="0" max="100"/>
      <default>100</default>
      <summary>Paper background opacity percentage</summary>
      <description>0 is transparent and 100 is solid. Does not fade Quran ink; the overall opacity setting still affects the whole widget.</description>
    </key>
    <key name="corner-radius" type="i">
      <range min="0" max="64"/>
      <default>24</default>
      <summary>Smooth corner radius in logical pixels</summary>
      <description>0 gives square corners. Applies to Mushaf pages and to the optional transparent-text backdrop.</description>
    </key>
    <key name="monitor" type="i">
      <range min="-1" max="15"/>
      <default>-1</default>
      <summary>Monitor index</summary>
      <description>Use -1 for the primary monitor, or a zero-based monitor index.</description>
    </key>
    <key name="hide-in-overview" type="b">
      <default>true</default>
      <summary>Hide in the Activities overview</summary>
    </key>
    <key name="font-name" type="s">
      <default>'Noto Naskh Arabic'</default>
      <summary>Arabic font family</summary>
    </key>
    <key name="text-color" type="s">
      <default>'#f4f1e9'</default>
      <summary>Text color</summary>
      <description>A hexadecimal RGB color in #RRGGBB format.</description>
    </key>
    <key name="show-backdrop" type="b">
      <default>false</default>
      <summary>Show a subtle backdrop behind the text</summary>
    </key>
    <key name="page-layout" type="s">
      <choices><choice value="madani"/><choice value="transparent"/></choices>
      <default>'madani'</default>
      <summary>Madani image pages or transparent reflowed text</summary>
    </key>
    <key name="mushaf-edition" type="s">
      <choices><choice value="madani"/><choice value="tajweed"/></choices>
      <default>'madani'</default>
      <summary>Mushaf edition: Madani or مصحف التجويد</summary>
      <description>Tajweed uses original color-coded page images, never a monochrome mask.</description>
    </key>
    <key name="page-theme" type="s">
      <choices><choice value="light"/><choice value="sepia"/><choice value="dark"/><choice value="automatic"/></choices>
      <default>'light'</default>
      <summary>Quran Android page appearance</summary>
    </key>
    <key name="night-text-brightness" type="i">
      <range min="120" max="255"/><default>255</default>
      <summary>Night text brightness</summary>
    </key>
    <key name="night-background-brightness" type="i">
      <range min="0" max="64"/><default>0</default>
      <summary>Night background brightness</summary>
    </key>
    <key name="use-old-background" type="b">
      <default>false</default><summary>Use the classic yellow paper instead of shaded light paper</summary>
    </key>
    <key name="show-page-info" type="b">
      <default>true</default><summary>Show surah, juz, and page number around the image</summary>
    </key>
    <key name="page-margin" type="i">
      <range min="12" max="56"/><default>24</default><summary>Madani page side margins</summary>
    </key>
    <key name="quran-previous-page" type="as">
      <default>['&lt;Control&gt;&lt;Alt&gt;Page_Up']</default>
      <summary>Shortcut for previous page</summary>
    </key>
    <key name="quran-next-page" type="as">
      <default>['&lt;Control&gt;&lt;Alt&gt;Page_Down']</default>
      <summary>Shortcut for next page</summary>
    </key>
    <key name="quran-first-page" type="as">
      <default>['&lt;Control&gt;&lt;Alt&gt;Home']</default>
      <summary>Shortcut for first page</summary>
    </key>
    <key name="quran-last-page" type="as">
      <default>['&lt;Control&gt;&lt;Alt&gt;End']</default>
      <summary>Shortcut for last page</summary>
    </key>
    <key name="quran-go-to-page" type="as">
      <default>['&lt;Control&gt;&lt;Alt&gt;g']</default>
      <summary>Shortcut for page input</summary>
    </key>
    <key name="quran-search" type="as">
      <default>['&lt;Control&gt;&lt;Alt&gt;f']</default>
      <summary>Shortcut for offline Quran search</summary>
    </key>
  </schema>
</schemalist>
